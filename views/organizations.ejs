<%- include("partials/header") %>

<h1><%= title %></h1>

<p>
  <a href="/new-organization">Add Organization</a>
</p>

<div class="organization-list">
  <% organizations.forEach((organization) => { %>
    <section class="card">
      <img
        src="/images/<%= organization.logo_filename %>"
        alt="<%= organization.name %> logo"
        class="organization-logo"
      >

      <h2>
        <a href="/organization/<%= organization.organization_id %>">
          <%= organization.name %>
        </a>
      </h2>

      <p><%= organization.description %></p>
      <p><strong>Contact:</strong> <%= organization.contact_email %></p>

      <p>
        <a href="/edit-organization/<%= organization.organization_id %>">
          Edit Organization
        </a>
      </p>
    </section>
  <% }) %>
</div>

<%- include("partials/footer") %>