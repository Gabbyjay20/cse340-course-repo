<%- include("partials/header") %>

<h1><%= project.title %></h1>

<p><strong>Description:</strong> <%= project.description %></p>
<p><strong>Date:</strong> <%= new Date(project.project_date).toLocaleDateString() %></p>
<p><strong>Location:</strong> <%= project.location %></p>

<p>
  <strong>Organization:</strong>
  <a href="/organization/<%= project.organization_id %>">
    <%= project.organization_name %>
  </a>
</p>

<h2>Categories</h2>

<ul>
  <% categories.forEach((category) => { %>
    <li>
      <a href="/category/<%= category.category_id %>">
        <%= category.name %>
      </a>
    </li>
  <% }) %>
</ul>

<p>
  <a href="/assign-categories/<%= project.project_id %>">
    Assign Categories
  </a>
</p>

<% if (currentUser) { %>

  <form
    action="/volunteer/<%= project.project_id %>"
    method="POST"
  >
    <button type="submit">
      Volunteer For This Project
    </button>
  </form>

<% } %>

<%- include("partials/footer") %>