<%- include("partials/header") %>

<h1>Assign Categories</h1>

<h2><%= project.title %></h2>

<form action="/assign-categories/<%= project.project_id %>" method="POST">

  <% categories.forEach((category) => { %>
    <div>
      <input
        type="checkbox"
        id="category-<%= category.category_id %>"
        name="categoryIds"
        value="<%= category.category_id %>"
        <%= assignedCategoryIds.includes(category.category_id) ? "checked" : "" %>
      >

      <label for="category-<%= category.category_id %>">
        <%= category.name %>
      </label>
    </div>
  <% }) %>

  <button type="submit">Save Categories</button>

</form>

<p>
  <a href="/project/<%= project.project_id %>">Back to Project</a>
</p>

<%- include("partials/footer") %>