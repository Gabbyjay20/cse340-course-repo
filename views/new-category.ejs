<%- include("partials/header") %>

<h1>New Category</h1>

<% if (errors.length > 0) { %>
  <ul>
    <% errors.forEach((error) => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/new-category" method="POST">

  <label for="name">Category Name</label>

  <input
    type="text"
    id="name"
    name="name"
    value="<%= category.name || '' %>"
    required
    maxlength="100"
  >

  <button type="submit">Create Category</button>

</form>

<%- include("partials/footer") %>